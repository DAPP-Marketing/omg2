---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/common/PageHero.astro';
import { company } from '../../data/company';
---
<BaseLayout title="お問い合わせ｜OMG株式会社" description="OMG株式会社への輸送・配送・物流業務に関するお問い合わせ窓口です。">
  <PageHero label="CONTACT" title="お問い合わせ" lead="輸送、配送、倉庫内作業について、お気軽にご相談ください。" />
  <section class="section-space bg-white">
    <div class="site-container grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-14">
      <aside><p class="section-kicker">BY PHONE</p><h2 class="section-title text-[clamp(2rem,4vw,3rem)]">お電話でのお問い合わせ</h2><p class="body-copy mt-5">ご相談内容を簡単にお伝えください。</p><a class="mt-6 block text-3xl font-black tracking-tight text-primary no-underline" href={`tel:${company.phone.replaceAll('-', '')}`}>{company.phone}</a></aside>
      <div class="rounded-card border border-line bg-soft p-5 shadow-card sm:p-8">
        <h2 class="text-2xl font-black">お問い合わせフォーム</h2>
        <p class="mt-3 text-sm leading-7 text-slate-600">必須項目をご入力ください。現在、送信先連携は準備中です。お急ぎの場合はお電話をご利用ください。</p>
        <form class="mt-8 grid gap-6" data-contact-form novalidate>
          <div><label class="mb-2 block font-black" for="company-name">会社名</label><input class="min-h-14 w-full rounded-xl border border-line bg-white px-4" id="company-name" name="companyName" type="text" autocomplete="organization" maxlength="120" /></div>
          <div><label class="mb-2 block font-black" for="name">お名前 <span class="text-primary">必須</span></label><input class="min-h-14 w-full rounded-xl border border-line bg-white px-4" id="name" name="name" type="text" autocomplete="name" maxlength="80" required /></div>
          <div class="grid gap-6 sm:grid-cols-2"><div><label class="mb-2 block font-black" for="tel">電話番号</label><input class="min-h-14 w-full rounded-xl border border-line bg-white px-4" id="tel" name="tel" type="tel" autocomplete="tel" inputmode="tel" pattern="[0-9()+ -]{10,20}" /></div><div><label class="mb-2 block font-black" for="email">メールアドレス <span class="text-primary">必須</span></label><input class="min-h-14 w-full rounded-xl border border-line bg-white px-4" id="email" name="email" type="email" autocomplete="email" maxlength="254" required /></div></div>
          <div><label class="mb-2 block font-black" for="inquiry-type">お問い合わせ種別 <span class="text-primary">必須</span></label><select class="min-h-14 w-full rounded-xl border border-line bg-white px-4" id="inquiry-type" name="inquiryType" required><option value="">選択してください</option><option>トラック輸送について</option><option>倉庫物流について</option><option>採用について</option><option>その他</option></select></div>
          <div><label class="mb-2 block font-black" for="message">お問い合わせ内容 <span class="text-primary">必須</span></label><textarea class="min-h-40 w-full rounded-xl border border-line bg-white p-4" id="message" name="message" maxlength="2000" required></textarea></div>
          <label class="flex items-start gap-3 rounded-xl bg-white p-4"><input class="mt-2" name="privacy" type="checkbox" required /><span>個人情報の取り扱いに同意する <span class="text-primary">必須</span><small class="block text-slate-500">※ 個人情報保護方針は公開前にリンク設定が必要です。</small></span></label>
          <button class="button-primary w-full" type="submit">入力内容を確認する</button>
          <p class="hidden rounded-xl bg-sky p-4 font-bold" role="status" tabindex="-1" data-form-status></p>
        </form>
      </div>
    </div>
  </section>
  <script>
    /** 送信先未設定の間、入力済み情報を外部送信せず準備中であることを明示する。 */
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const status = document.querySelector<HTMLElement>('[data-form-status]');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      if (!status) return;
      status.textContent = '入力ありがとうございます。現在オンライン送信は準備中です。お手数ですが、お急ぎの場合はお電話でお問い合わせください。';
      status.classList.remove('hidden');
      status.focus();
    });
  </script>
</BaseLayout>
