---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/common/PageHero.astro';
import ContactCTA from '../../components/common/ContactCTA.astro';
import { company } from '../../data/company';

const profile = [
  ['社名', company.name], ['所在地', company.address], ['代表取締役', '加藤 智樹'], ['資本金', company.capital], ['設立', company.established], ['従業員', company.employees], ['車両台数', company.vehicles.join('／')], ['許認可', company.permits.join('／')],
] as const;
---
<BaseLayout title="会社案内｜OMG株式会社" description="OMG株式会社の代表メッセージ、経営理念、会社概要、本社・営業所情報をご案内します。">
  <PageHero label="COMPANY" title="会社案内" lead="安全な物流と、人とのつながりを大切に。OMG株式会社が目指す姿をご紹介します。" />

  <section class="section-space bg-white" aria-labelledby="message-title">
    <div class="site-container grid items-center gap-10 md:grid-cols-[0.85fr_1.15fr] md:gap-16">
      <div class="photo-placeholder min-h-[24rem]" role="img" aria-label="代表者写真 差し替え予定"><div class="photo-placeholder__inner"><span class="photo-placeholder__icon" aria-hidden="true">＋</span><span class="photo-placeholder__label">代表者写真 差し替えエリア</span></div></div>
      <div><p class="section-kicker">MESSAGE</p><h2 id="message-title" class="section-title">「感謝」と「安全」を、<br />いつも心に。</h2><p class="body-copy mt-7">OMG株式会社は2015年、物流企業の運送支援から始まりました。さまざまな積み荷と地域をつなぐ仕事を重ね、倉庫での仕分け、拠点間輸送、配送へと事業を広げています。</p><p class="body-copy mt-4">年齢・性別・国籍を問わず集まった仲間とともに、皆さまから信頼される安全な物流を続けていきます。</p><p class="mt-7 font-black">{company.representative}</p></div>
    </div>
  </section>

  <section class="section-space bg-soft" aria-labelledby="profile-title">
    <div class="site-container"><p class="section-kicker">PROFILE</p><h2 id="profile-title" class="section-title">会社概要</h2>
      <dl class="mt-10 overflow-hidden rounded-card border border-line bg-white shadow-card">
        {profile.map(([term, value]) => <div class="grid gap-2 border-b border-line p-5 last:border-b-0 sm:grid-cols-[10rem_1fr] sm:p-6"><dt class="font-black text-primary">{term}</dt><dd>{value}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section-space bg-white" aria-labelledby="office-title">
    <div class="site-container"><p class="section-kicker">OFFICE</p><h2 id="office-title" class="section-title">拠点情報</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2">{company.offices.map((office) => <article class="rounded-card border border-line p-7"><h3 class="text-xl font-black">{office.name}</h3><p class="mt-3 text-slate-600">{office.address}</p></article>)}</div>
    </div>
  </section>
  <ContactCTA />
</BaseLayout>
