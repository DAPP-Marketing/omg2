---
/** TOPページの募集要項抜粋。確認済みの共通条件のみを表示する。 */
import { recruitConditions } from '../../data/recruit';
---
<section class="section-space bg-soft" aria-labelledby="recruit-title">
  <div class="site-container grid gap-10 md:grid-cols-[0.75fr_1.25fr] md:gap-16" data-reveal>
    <div><p class="section-kicker">05 RECRUIT</p><h2 id="recruit-title" class="section-title">募集要項</h2><p class="body-copy mt-6">現在、ドライバーと倉庫業務管理者を募集しています。</p><a class="button-primary mt-8" href="/recruit/">募集要項を見る <span aria-hidden="true">→</span></a></div>
    <div class="overflow-hidden rounded-card border border-line bg-white shadow-card">
      <dl>
        <div class="grid gap-1 border-b border-line p-6 sm:grid-cols-[8rem_1fr]"><dt class="font-black text-primary">雇用形態</dt><dd>正社員</dd></div>
        <div class="grid gap-1 border-b border-line p-6 sm:grid-cols-[8rem_1fr]"><dt class="font-black text-primary">募集職種</dt><dd>{recruitConditions.map((item) => item.jobTitle).join('／')}</dd></div>
        <div class="grid gap-1 border-b border-line p-6 sm:grid-cols-[8rem_1fr]"><dt class="font-black text-primary">休日</dt><dd>日曜、祝日、年末年始、お盆</dd></div>
        <div class="grid gap-1 p-6 sm:grid-cols-[8rem_1fr]"><dt class="font-black text-primary">福利厚生</dt><dd>各社会保険完備、資格取得推奨制度 他</dd></div>
      </dl>
    </div>
  </div>
</section>
