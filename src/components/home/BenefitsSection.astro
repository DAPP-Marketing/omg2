---
/** TOPページの「OMGで働く魅力」。更新内容は src/data/benefits.ts で管理する。 */
import { benefits } from '../../data/benefits';
---
<section class="section-space bg-sky" aria-labelledby="benefits-title">
  <div class="site-container" data-reveal>
    <p class="section-kicker">03 BENEFITS</p>
    <h2 id="benefits-title" class="section-title">安心して、一歩ずつ。</h2>
    <p class="body-copy mt-6">新しい仕事を始める不安に、仲間と会社の仕組みで寄り添います。</p>
    <div class="mt-10 grid gap-5 md:grid-cols-3 md:gap-6">
      {benefits.map((benefit) => (
        <article class="rounded-card border border-white bg-white p-7 shadow-card md:p-8">
          <span class="text-sm font-black tracking-[0.12em] text-primary">{benefit.number}</span>
          <h3 class="mt-4 text-2xl font-black leading-snug">{benefit.title}</h3>
          <p class="mt-4 text-base leading-8 text-slate-600">{benefit.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
