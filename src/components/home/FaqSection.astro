---
/** TOPページのFAQ。details要素でキーボード操作にも対応する。 */
import { faqs } from '../../data/faq';
---
<section id="faq" class="section-space bg-white" aria-labelledby="faq-title">
  <div class="site-container max-w-4xl" data-reveal>
    <p class="section-kicker">06 FAQ</p>
    <h2 id="faq-title" class="section-title">よくある質問</h2>
    <div class="mt-10 grid gap-4">
      {faqs.map((faq, index) => (
        <details class="group rounded-2xl border border-line bg-white px-5 py-1 shadow-sm md:px-7" open={index === 0}>
          <summary class="flex min-h-20 cursor-pointer items-center justify-between gap-4 font-black"><span class="flex gap-3"><span class="text-primary">Q.</span>{faq.question}</span><span class="text-2xl text-primary group-open:rotate-45" aria-hidden="true">＋</span></summary>
          <div class="border-t border-line py-5 text-slate-600"><p class="flex gap-3"><strong class="text-navy">A.</strong><span>{faq.answer}</span></p></div>
        </details>
      ))}
    </div>
  </div>
</section>
