---
/** TOPの事業紹介。詳細は src/data/business.ts で管理する。 */
import { businesses } from '../../data/business';
---
<section class="section-space bg-white" aria-labelledby="business-title">
  <div class="site-container" data-reveal>
    <p class="section-kicker">01 BUSINESS</p>
    <div class="md:flex md:items-end md:justify-between md:gap-10"><h2 id="business-title" class="section-title">運ぶ力と、<br />支える力。</h2><p class="body-copy mt-5 md:mt-0 md:max-w-lg">お客様の物量や商品に合わせたトラック輸送と、倉庫内での物流業務。2つの事業で物流を支えます。</p></div>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {businesses.map((business) => <article class="overflow-hidden rounded-card border border-line bg-white shadow-card"><div class="photo-placeholder min-h-[15rem] rounded-none border-0 border-b border-line" role="img" aria-label={`${business.title}の写真 差し替え予定`}><div class="photo-placeholder__inner"><span class="photo-placeholder__icon" aria-hidden="true">＋</span><span class="photo-placeholder__label">{business.title} 写真</span></div></div><div class="p-7 md:p-9"><span class="text-sm font-black tracking-[0.12em] text-primary">{business.number}</span><h3 class="mt-3 text-2xl font-black">{business.title}</h3><p class="mt-4 text-slate-600">{business.lead}</p></div></article>)}
    </div>
    <div class="mt-9 text-center"><a class="button-primary" href="/business/">事業内容を詳しく見る <span aria-hidden="true">→</span></a></div>
  </div>
</section>
