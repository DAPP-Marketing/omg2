---
/** 下層ページ共通の見出し。ページごとの役割を短く伝える。 */
interface Props { label: string; title: string; lead: string; }
const { label, title, lead } = Astro.props;
---
<section class="overflow-hidden bg-sky py-16 md:py-24">
  <div class="site-container">
    <p class="section-kicker">{label}</p>
    <h1 class="m-0 text-[clamp(2.5rem,7vw,4.75rem)] font-black leading-tight tracking-[-0.05em]">{title}</h1>
    <p class="body-copy mt-6">{lead}</p>
  </div>
</section>
